# Copy this file to .env.local and fill in your own values.
# .env.local is git-ignored. NEVER commit real keys.

# --- Neon Postgres -------------------------------------------------------
# Pooled connection string (used by the app at runtime).
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
# Direct (non-pooled) connection string - the same URL without "-pooler" in the host.
# Used for migrations. If omitted, it is derived from DATABASE_URL automatically.
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require

# --- LLM: Google AI Studio (Gemini) ---------------------------------------
# Create one at https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=
# Optional: model used for lesson generation (default: gemini-3.5-flash)
# GEMINI_MODEL=gemini-3.5-flash
# Optional: comma-separated fallbacks, tried when the model above is out of quota or busy.
# The free tier is limited PER MODEL PER DAY, so a chain keeps the app working longer.
# GEMINI_FALLBACK_MODELS=gemini-3.7-flash,gemini-3.5-flash-lite

# --- Voice: ElevenLabs ------------------------------------------------------
# Create one at https://elevenlabs.io/app/settings/api-keys (enable "Text to Speech").
ELEVENLABS_API_KEY=
# Optional: voice to use. Free plans can only use the premade voices through the API.
# ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
# Optional: model (default: eleven_flash_v2_5, the cheapest and fastest).
# ELEVENLABS_MODEL=eleven_flash_v2_5

# --- App behaviour (all optional) ------------------------------------------
# "elevenlabs" (default) or "browser" (no TTS credits used; the browser speaks the lesson).
# TTS_PROVIDER=elevenlabs
# Per-visitor limits, per hour.
# RATE_LIMIT_LESSONS_PER_HOUR=8
# RATE_LIMIT_MESSAGES_PER_HOUR=40
